{
  "name": "obsidian-git-sync",
  "version": "0.1.0",
  "description": "Automatic Obsidian vault sync over git, modeled on Obsidian Sync.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.42.3",
    "node-diff3": "^3.2.1"
  }
}
